{
  "name": "tutor-app",
  "version": "1.0.0",
  "description": "家教管理App — 一人公司",
  "main": "electron-main.js",
  "scripts": {
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "build:electron": "npm run build:h5 && electron-builder --win",
    "build:exe": "npm run build:h5 && electron-builder --win portable",
    "electron:dev": "npm run build:h5 && electron ."
  },
  "build": {
    "appId": "com.tutor.app",
    "productName": "家教管理",
    "directories": {
      "output": "dist/electron"
    },
    "asar": false,
    "win": {
      "icon": "src/static/logo.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/static/logo.ico",
      "uninstallerIcon": "src/static/logo.ico",
      "installerHeaderIcon": "src/static/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "家教管理",
      "artifactName": "家教管理-Setup-${version}.exe"
    },
    "files": [
      "dist/build/h5/**/*",
      "electron-main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha",
    "@dcloudio/uni-app-plus": "^3.0.0-alpha",
    "@dcloudio/uni-components": "^3.0.0-alpha",
    "@dcloudio/uni-h5": "^3.0.0-alpha",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.0.0-alpha",
    "@dcloudio/uni-automator": "^3.0.0-alpha",
    "@dcloudio/uni-cli-shared": "^3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-5020120260710001",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "sass": "^1.70.0",
    "vite": "^5.0.0"
  }
}
